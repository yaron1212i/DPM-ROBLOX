--  PREMIUM NOTIFICATION — glass style
-- =============================================
local function notify(msg, sub)
    local n=Instance.new("Frame")
    n.Size=UDim2.new(0,220,0,46); n.Position=UDim2.new(0.5,-110,-0.12,0)
    n.BackgroundColor3=Color3.fromRGB(12,12,16); n.BackgroundTransparency=0.25
    n.BorderSizePixel=0; n.Parent=SG
    Instance.new("UICorner",n).CornerRadius=UDim.new(0,10)

    local ng=Instance.new("UIGradient")
    ng.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,Color3.fromRGB(38,38,50)),
        ColorSequenceKeypoint.new(1,Color3.fromRGB(10,10,14)),
    })
    ng.Rotation=135; ng.Parent=n

    local nStroke=Instance.new("UIStroke"); nStroke.Color=Color3.new(1,1,1)
    nStroke.Thickness=0.8; nStroke.Transparency=0.65; nStroke.Parent=n

    -- shimmer top
    local nShim=Instance.new("Frame"); nShim.Size=UDim2.new(0.5,0,0,1)
    nShim.Position=UDim2.new(0.25,0,0,0); nShim.BackgroundColor3=Color3.new(1,1,1)
    nShim.BackgroundTransparency=0.55; nShim.BorderSizePixel=0; nShim.Parent=n
    Instance.new("UICorner",nShim).CornerRadius=UDim.new(1,0)

    local side=Instance.new("Frame"); side.Size=UDim2.new(0,2,1,-10)
    side.Position=UDim2.new(0,0,0,5); side.BackgroundColor3=Color3.new(1,1,1)
    side.BackgroundTransparency=0.15; side.BorderSizePixel=0; side.Parent=n
    Instance.new("UICorner",side).CornerRadius=UDim.new(0,2)

    local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-12,0,18)
    lbl.Position=UDim2.new(0,10,0,6); lbl.BackgroundTransparency=1
    lbl.Text=msg; lbl.TextColor3=Color3.new(1,1,1); lbl.TextSize=11
    lbl.Font=Enum.Font.GothamBold; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=n

    if sub then
        local sl=Instance.new("TextLabel"); sl.Size=UDim2.new(1,-12,0,12)
        sl.Position=UDim2.new(0,10,0,26); sl.BackgroundTransparency=1
        sl.Text=sub; sl.TextColor3=T.dim; sl.TextSize=8
        sl.Font=Enum.Font.Gotham; sl.TextXAlignment=Enum.TextXAlignment.Left; sl.Parent=n
    end

    TweenService:Create(n,TweenInfo.new(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
        Position=UDim2.new(0.5,-110,0.02,0)
    }):Play()
    task.delay(2.5,function()
        TweenService:Create(n,TweenInfo.new(0.25,Enum.EasingStyle.Back,Enum.EasingDirection.In),{
            Position=UDim2.new(0.5,-110,-0.12,0),
            BackgroundTransparency=1,
        }):Play()
        task.wait(0.3); n:Destroy()
    end)
end

