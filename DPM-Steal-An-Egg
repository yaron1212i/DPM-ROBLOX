FlyHUD.Visible=false; FlyHUD.Parent=SG

local function mFB(lbl,x,y,w,h,dir)
    local b=Instance.new("TextButton"); b.Text=lbl
    b.Size=UDim2.new(0,w,0,h); b.Position=UDim2.new(0,x,0,y)
    b.BackgroundColor3=Color3.fromRGB(12,12,16); b.BackgroundTransparency=0.2
    b.TextColor3=Color3.new(1,1,1); b.TextSize=16; b.Font=Enum.Font.GothamBold
    b.BorderSizePixel=0; b.Parent=FlyHUD
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,9)
    local st=Instance.new("UIStroke"); st.Color=Color3.new(1,1,1); st.Thickness=0.8
    st.Transparency=0.7; st.Parent=b
    b.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
            flyDir=flyDir+dir
            TweenService:Create(b,TweenInfo.new(0.1),{BackgroundColor3=Color3.new(1,1,1),TextColor3=Color3.fromRGB(10,10,14)}):Play()
        end
    end)
    b.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
            flyDir=flyDir-dir
            TweenService:Create(b,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(12,12,16),TextColor3=Color3.new(1,1,1)}):Play()
        end
    end)
end
