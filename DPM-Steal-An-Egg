-- =============================================
--  HELPER: find egg/pet objects
-- =============================================
local function findEggs()
    local eggs={}
    for _,v in pairs(workspace:GetDescendants()) do
        local n=v.Name:lower()
        if v:IsA("BasePart") or v:IsA("Model") then
            if n:find("egg") then table.insert(eggs,v) end
        end
    end
    return eggs
end

local function findFuseMachine()
    for _,v in pairs(workspace:GetDescendants()) do
        local n=v.Name:lower()
        if n:find("fuse") then return v end
    end
    return nil
end

local function findTreadmill()
    for _,v in pairs(workspace:GetDescendants()) do
        local n=v.Name:lower()
        if n:find("treadmill") then return v end
    end
    return nil
end

local function findPets()
    local pets={}
    for _,v in pairs(workspace:GetDescendants()) do
        local n=v.Name:lower()
        if n:find("pet") or n:find("animal") then
            table.insert(pets,v)
        end
    end
    return pets
end

local function closestEgg()
    if not Root then return nil end
    local best,bd=nil,math.huge
    for _,v in pairs(findEggs()) do
        local pos
        if v:IsA("BasePart") then pos=v.Position
        elseif v:IsA("Model") then
            local hrp=v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
            if hrp then pos=hrp.Position end
        end
        if pos then
            local d=(pos-Root.Position).Magnitude
            if d<bd then bd=d; best=v end
        end
    end
    return best
end

