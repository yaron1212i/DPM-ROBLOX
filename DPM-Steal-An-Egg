        while _G.dpm_farm do
            if not Root or not Hum then task.wait(0.5) continue end

            -- step 1: find the closest egg
            local egg=closestEgg()
            if egg then
                local ePos
                if egg:IsA("BasePart") then ePos=egg.Position
                elseif egg:IsA("Model") then
                    local p=egg:FindFirstChild("HumanoidRootPart") or egg.PrimaryPart
                    if p then ePos=p.Position end
                end

                if ePos then
                    -- teleport to egg
                    Root.CFrame=CFrame.new(ePos+Vector3.new(0,3,0))
                    task.wait(0.3)

                    -- try to fire pick up remotes
                    for _,v in pairs(game:GetDescendants()) do
                        if v:IsA("RemoteEvent") then
                            local n=v.Name:lower()
                            if n:find("pickup") or n:find("steal") or n:find("grab") or n:find("collect") or n:find("egg") then
