toggle("FUSE","Hook Fuse Remote","injects luck=100 into fuse calls",function(on)
    _G.dpm_fusehook=on
    pcall(function()
        local mt=getrawmetatable(game); local old=mt.__namecall
        setreadonly(mt,false)
        mt.__namecall=newcclosure(function(self,...)
            local args={...}; local method=getnamecallmethod()
            if _G.dpm_fusehook and (method=="FireServer" or method=="InvokeServer") then
                local n=tostring(self.Name):lower()
                if n:find("fuse") or n:find("merge") or n:find("combine") or n:find("evolve") then
                    table.insert(args,100); table.insert(args,{luck=100,bonus=100,multiplier=10})
                    notify("Fuse hooked","luck injected")
                end
            end
            return old(self,unpack(args))
        end)
        setreadonly(mt,true)
    end)
end)

