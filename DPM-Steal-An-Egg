--  EASING HELPERS
-- =============================================
local function animateIn(frame, targetSize, targetPos)
    frame.Size     = UDim2.new(0, targetSize.X.Offset*0.85, 0, targetSize.Y.Offset*0.85)
    frame.Position = UDim2.new(targetPos.X.Scale, targetPos.X.Offset, targetPos.Y.Scale, targetPos.Y.Offset + 18)
    frame.BackgroundTransparency = 1
    TweenService:Create(frame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size     = targetSize,
        Position = targetPos,
        BackgroundTransparency = 0.35,
    }):Play()
end

