-- =============================================
--  SCAN REMOTES — runs on load, cached
-- =============================================
local remoteCache = {}
task.spawn(function()
    for _,v in pairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            local n=v.Name:lower()
            remoteCache[n]=v
            -- index by partial keys
            for _,key in pairs({"egg","fuse","hatch","open","spawn","grab","steal",
                                 "collect","pick","merge","combine","farm","pet","buy","sell"}) do
                if n:find(key) then
                    if not remoteCache["_"..key] then remoteCache["_"..key]={} end
                    table.insert(remoteCache["_"..key],v)
                end
            end
        end
    end
    print("[DPM] Remotes scanned: "..tostring(#remoteCache))
end)

local function fireRemote(key,...)
    local list=remoteCache["_"..key]
    if list then
        for _,r in pairs(list) do
            pcall(function()
                if r:IsA("RemoteEvent") then r:FireServer(...)
                else r:InvokeServer(...) end
            end)
        end
        return true
    end
    return false
end

-- =============================================
--  EGG SCANNER — finds ALL eggs in workspace
-- =============================================
local function scanEggs()
    local eggs={}
    for _,v in pairs(workspace:GetDescendants()) do
        local n=v.Name:lower()
        if n:find("egg") then
            local pos,part=nil,nil
            if v:IsA("Model") then
                local bp=v.PrimaryPart or v:FindFirstChildOfClass("BasePart")
                if bp then pos=bp.Position; part=v end
            elseif v:IsA("BasePart") then
                pos=v.Position; part=v
            end
            if pos and part then
                table.insert(eggs,{name=v.Name,pos=pos,obj=part})
            end
        end
    end
    -- sort by distance
    if Root then
        table.sort(eggs,function(a,b)
            return (a.pos-Root.Position).Magnitude < (b.pos-Root.Position).Magnitude
        end)
    end
    return eggs
end

