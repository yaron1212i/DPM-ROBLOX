toggle("MISC","ESP Players","labels above all players",function(on)
    local esps={}
    local function add(p)
        if p==LP then return end
        local function onChar(c)
            task.wait(0.4)
            local hrp=c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
            local bb=Instance.new("BillboardGui"); bb.Size=UDim2.new(0,100,0,24)
            bb.StudsOffset=Vector3.new(0,3.5,0); bb.AlwaysOnTop=true; bb.Adornee=hrp; bb.Parent=hrp
            local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(1,0,1,0)
            lbl.BackgroundTransparency=1; lbl.Text=p.Name; lbl.TextColor3=Color3.new(1,1,1)
            lbl.TextSize=11; lbl.Font=Enum.Font.GothamBold; lbl.Parent=bb
            esps[p]=bb
        end
        if p.Character then onChar(p.Character) end
        p.CharacterAdded:Connect(onChar)
    end
    if on then
        for _,p in pairs(Players:GetPlayers()) do add(p) end
        Players.PlayerAdded:Connect(add)
    else for _,v in pairs(esps) do v:Destroy() end; esps={} end
end)

