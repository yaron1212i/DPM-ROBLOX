actionBtn("FARM","Single Farm Run","runs one full egg sweep now",function()
    task.spawn(function()
        local eggs=scanEggs()
        notify("Farm run","collecting "..#eggs.." eggs")
        for _,e in pairs(eggs) do
            if Root then
                Root.CFrame=CFrame.new(e.pos+Vector3.new(0,3,0)); task.wait(0.25)
                fireRemote("grab",e.obj); fireRemote("collect",e.obj)
                fireRemote("steal",e.obj); fireRemote("egg",e.obj)
            end
        end
        notify("Farm run done","swept "..#eggs.." eggs")
    end)
end)

actionBtn("FARM","Print Farm Remotes","shows all farming remotes",function()
