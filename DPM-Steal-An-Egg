    local mt=getrawmetatable(game)
    local old=mt.__namecall
    setreadonly(mt,false)
    mt.__namecall=newcclosure(function(self,...)
        local args={...}
        local method=getnamecallmethod()
        if _G.dpm_fusehook and (method=="FireServer" or method=="InvokeServer") then
            local name=tostring(self.Name):lower()
            if name:find("fuse") or name:find("combine") or name:find("merge") or name:find("evolve") then
                -- inject max luck arg
                table.insert(args,100)
                table.insert(args,{luck=100,bonus=100,multiplier=10})
                notify("Fuse hooked","luck injected into call")
            end
        end
        return old(self,unpack(args))
    end)
    setreadonly(mt,true)
end)

