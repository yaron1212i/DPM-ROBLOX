    nm.ZIndex=4; nm.Parent=card

    local valLbl=Instance.new("TextLabel"); valLbl.Text=tostring(val)
    valLbl.Size=UDim2.new(0.35,0,0,16); valLbl.Position=UDim2.new(0.65,0,0,6)
    valLbl.BackgroundTransparency=1; valLbl.TextColor3=T.white; valLbl.TextSize=10
    valLbl.Font=Enum.Font.GothamBold; valLbl.TextXAlignment=Enum.TextXAlignment.Right
    valLbl.ZIndex=4; valLbl.Parent=card

    local ds=Instance.new("TextLabel"); ds.Text=desc
    ds.Size=UDim2.new(1,-10,0,11); ds.Position=UDim2.new(0,8,0,22)
    ds.BackgroundTransparency=1; ds.TextColor3=T.dim; ds.TextSize=8
    ds.Font=Enum.Font.Gotham; ds.TextXAlignment=Enum.TextXAlignment.Left
    ds.ZIndex=4; ds.Parent=card

    -- slider track
    local track=Instance.new("Frame")
    track.Size=UDim2.new(1,-16,0,4); track.Position=UDim2.new(0,8,0,42)
    track.BackgroundColor3=T.dimDark; track.BackgroundTransparency=0.3
    track.BorderSizePixel=0; track.ZIndex=4; track.Parent=card
    Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)

    local fill=Instance.new("Frame")
    local pct=(val-minV)/(maxV-minV)
    fill.Size=UDim2.new(pct,0,1,0)
    fill.BackgroundColor3=Color3.new(1,1,1); fill.BackgroundTransparency=0
    fill.BorderSizePixel=0; fill.ZIndex=5; fill.Parent=track
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

    local thumb=Instance.new("Frame")
    thumb.Size=UDim2.new(0,14,0,14)
    thumb.Position=UDim2.new(pct,-7,0.5,-7)
    thumb.BackgroundColor3=Color3.new(1,1,1)
    thumb.BorderSizePixel=0; thumb.ZIndex=6; thumb.Parent=track
    Instance.new("UICorner",thumb).CornerRadius=UDim.new(1,0)

    -- +/- buttons
    local mBtn=Instance.new("TextButton"); mBtn.Text="-"
    mBtn.Size=UDim2.new(0,22,0,16); mBtn.Position=UDim2.new(0,8,1,-22)
    mBtn.BackgroundColor3=Color3.fromRGB(28,28,38); mBtn.BackgroundTransparency=0.2
    mBtn.TextColor3=T.white; mBtn.TextSize=13; mBtn.Font=Enum.Font.GothamBold
    mBtn.BorderSizePixel=0; mBtn.ZIndex=5; mBtn.Parent=card
    Instance.new("UICorner",mBtn).CornerRadius=UDim.new(0,5)

    local pBtn=Instance.new("TextButton"); pBtn.Text="+"
    pBtn.Size=UDim2.new(0,22,0,16); pBtn.Position=UDim2.new(0,34,1,-22)
    pBtn.BackgroundColor3=Color3.fromRGB(28,28,38); pBtn.BackgroundTransparency=0.2
    pBtn.TextColor3=T.white; pBtn.TextSize=13; pBtn.Font=Enum.Font.GothamBold
    pBtn.BorderSizePixel=0; pBtn.ZIndex=5; pBtn.Parent=card
    Instance.new("UICorner",pBtn).CornerRadius=UDim.new(0,5)

    local step=math.max(1,math.floor((maxV-minV)/20))
    local function update(v)
        val=math.clamp(math.floor(v),minV,maxV)
        valLbl.Text=tostring(val)
        local p=(val-minV)/(maxV-minV)
        TweenService:Create(fill,TweenInfo.new(0.12),{Size=UDim2.new(p,0,1,0)}):Play()
        TweenService:Create(thumb,TweenInfo.new(0.12),{Position=UDim2.new(p,-7,0.5,-7)}):Play()
        cb(val)
    end

    mBtn.MouseButton1Click:Connect(function() update(val-step) end)
    pBtn.MouseButton1Click:Connect(function() update(val+step) end)

    -- drag on track
    local draggingSlider=false
    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch or
           i.UserInputType==Enum.UserInputType.MouseButton1 then
            draggingSlider=true
        end
    end)
    track.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch or
           i.UserInputType==Enum.UserInputType.MouseButton1 then
            draggingSlider=false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if draggingSlider and (i.UserInputType==Enum.UserInputType.Touch or
                               i.UserInputType==Enum.UserInputType.MouseMovement) then
            local rel=i.Position.X-track.AbsolutePosition.X
            local p=math.clamp(rel/track.AbsoluteSize.X,0,1)
            update(minV+p*(maxV-minV))
        end
    end)
end

