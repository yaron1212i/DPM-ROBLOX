actionBtn("TELE","TP to Nearest Egg","teleport to closest egg",function()
    if not Root then return end
    local best,bd=nil,math.huge
    for _,v in pairs(workspace:GetDescendants()) do
        if (v:IsA("BasePart") or v:IsA("Model")) and v.Name:lower():find("egg") then
            local pos
            if v:IsA("Model") then
                pos=v:GetBoundingBox().Position
            else
                pos=v.Position
            end
            local d=(pos-Root.Position).Magnitude
            if d<bd and d>1 then bd=d; best=pos end
        end
    end
    if best then
        Root.CFrame=CFrame.new(best+Vector3.new(0,4,0))
        notify("Teleported","to nearest egg")
    else
        notify("No eggs found","in workspace")
    end
end)

