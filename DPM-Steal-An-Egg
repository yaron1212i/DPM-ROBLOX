-- common egg names found in Steal An Egg
local eggList = {
    "Basic Egg","Stone Egg","Gold Egg","Diamond Egg",
    "Rainbow Egg","Legendary Egg","Mythic Egg","Cosmic Egg",
    "Fire Egg","Ice Egg","Shadow Egg","Light Egg",
    "Ancient Egg","Dragon Egg","Galaxy Egg","Crystal Egg",
    "Thunder Egg","Ocean Egg","Nature Egg","Void Egg",
    "Phoenix Egg","Angel Egg","Demon Egg","Starter Egg",
}

local function trySpawnEgg(eggName)
    -- Method 1: find SpawnEgg or OpenEgg remote
    local spawnRemote = nil
    for _,v in pairs(RS:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            local n=v.Name:lower()
            if n:find("spawn") or n:find("hatch") or n:find("open") or n:find("egg") then
                spawnRemote=v
                break
            end
        end
    end

    if spawnRemote then
        if spawnRemote:IsA("RemoteEvent") then
            spawnRemote:FireServer(eggName)
        elseif spawnRemote:IsA("RemoteFunction") then
            spawnRemote:InvokeServer(eggName)
        end
        notify("Spawning "..eggName,"firing egg remote")
        return
    end

    -- Method 2: find egg object in workspace and clone near player
    for _,v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name:lower():find("egg") then
            local match=v.Name:lower():find(eggName:lower():sub(1,4))
            if match then
                local clone=v:Clone()
                if Root then
                    clone:SetPrimaryPartCFrame(
                        CFrame.new(Root.Position+Vector3.new(math.random(-5,5),2,math.random(-5,5)))
                    )
                end
                clone.Parent=workspace
                notify("Spawned "..v.Name,"cloned from workspace")
                game:GetService("Debris"):AddItem(clone,30)
                return
            end
        end
    end

    -- Method 3: direct workspace clone of any egg
    for _,v in pairs(workspace:GetDescendants()) do
        if (v:IsA("Model") or v:IsA("Part")) and v.Name:lower():find("egg") then
            local clone=v:Clone()
            if clone:IsA("Model") and Root then
                clone:SetPrimaryPartCFrame(
                    CFrame.new(Root.Position+Vector3.new(math.random(-4,4),3,math.random(-4,4)))
                )
            elseif clone:IsA("BasePart") and Root then
                clone.Position=Root.Position+Vector3.new(math.random(-4,4),3,math.random(-4,4))
                clone.Anchored=false
            end
            clone.Parent=workspace
            notify("Spawned egg","cloned from map")
            game:GetService("Debris"):AddItem(clone,30)
