--  EASING HELPERS
-- =============================================
local function spring(t) return 1 - math.exp(-6*t) * math.cos(10*t) end

local function animateIn(frame, targetSize, targetPos)
    frame.Size     = UDim2.new(0, targetSize.X.Offset*0.85, 0, targetSize.Y.Offset*0.85)
    frame.Position = UDim2.new(targetPos.X.Scale, targetPos.X.Offset, targetPos.Y.Scale, targetPos.Y.Offset + 18)
    frame.BackgroundTransparency = 1
    local ti = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    TweenService:Create(frame, ti, {
        Size     = targetSize,
        Position = targetPos,
        BackgroundTransparency = 0.35,
    }):Play()
end

