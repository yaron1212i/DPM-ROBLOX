local function isScriptRequest(input)
    local l=input:lower()
    local scriptKeywords={"create","make","write","generate","build","give me","can you make","can you write","i want a","i need a"}
    local modKeywords={"speed","fly","esp","aimbot","kill aura","god mode","noclip","no clip","teleport","farm","gui","menu","jump","fling","bhop","gravity","hitbox","reach","stamina","remote","chat spam","anti afk","aura"}
    for _,sk in pairs(scriptKeywords) do
        if l:find(sk) then
            for _,mk in pairs(modKeywords) do
                if l:find(mk) then return true end
            end
        end
    end
    return false
end

local function getAIResponse(input)
    if isScriptRequest(input) then
        return {type="code", content=generateScript(input)}
    end
    local lower=input:lower()
    for _,entry in pairs(responses) do
        for _,pat in pairs(entry.patterns) do
            if lower:find(pat) then
                local ans=entry.answers
                local picked=ans[math.random(1,#ans)]
                if picked=="__CODEGEN__" then
                    return {type="code",content=generateScript(input)}
                end
                return {type="text",content=picked}
            end
        end
    end
    return {type="text",content=fallbacks[math.random(1,#fallbacks)]}
end

