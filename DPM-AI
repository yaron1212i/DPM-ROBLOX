    tb.Position=UDim2.new(0,4,0,0); tb.BackgroundColor3=T.aiBG
    tb.BackgroundTransparency=0.15; tb.BorderSizePixel=0; tb.ZIndex=5; tb.Parent=typingW
    Instance.new("UICorner",tb).CornerRadius=UDim.new(0,12)

    local dH=Instance.new("Frame"); dH.Size=UDim2.new(1,0,1,0); dH.BackgroundTransparency=1
    dH.ZIndex=6; dH.Parent=tb
    local dL2=Instance.new("UIListLayout"); dL2.FillDirection=Enum.FillDirection.Horizontal
    dL2.HorizontalAlignment=Enum.HorizontalAlignment.Center
    dL2.VerticalAlignment=Enum.VerticalAlignment.Center
    dL2.Padding=UDim.new(0,5); dL2.Parent=dH

    local dots={}
    for i=1,3 do
        local d=Instance.new("Frame"); d.Size=UDim2.new(0,7,0,7)
        d.BackgroundColor3=T.dim; d.BackgroundTransparency=0.2
        d.BorderSizePixel=0; d.ZIndex=7; d.Parent=dH
        Instance.new("UICorner",d).CornerRadius=UDim.new(1,0)
        dots[i]=d
    end

    typingConn=RunService.Heartbeat:Connect(function()
        local t=tick()
        for i,d in pairs(dots) do
            local v=0.5+math.sin((t+(i-1)*0.25)*4)*0.5
            d.BackgroundColor3=Color3.fromRGB(math.floor(255*v),math.floor(255*v),math.floor(255*v))
        end
    end)
    scrollBottom()
end

local function hideTyping()
    if typingConn then typingConn:Disconnect(); typingConn=nil end
    if typingW then typingW:Destroy(); typingW=nil end
end

