--  CHAT BUBBLE BUILDER
-- =============================================
local messageCount=0

local function scrollToBottom()
    task.wait(0.05)
    ChatFrame.CanvasPosition=Vector2.new(0,ChatFrame.AbsoluteCanvasSize.Y)
end

local function addBubble(text, isUser)
    messageCount=messageCount+1

    -- wrapper frame (full width for alignment)
    local wrapper=Instance.new("Frame")
    wrapper.Name="Msg"..messageCount
    wrapper.Size=UDim2.new(1,0,0,0)
    wrapper.AutomaticSize=Enum.AutomaticSize.Y
    wrapper.BackgroundTransparency=1
    wrapper.BorderSizePixel=0
    wrapper.LayoutOrder=messageCount
    wrapper.ZIndex=4
    wrapper.Parent=ChatFrame

    -- label for measuring
    local measure=Instance.new("TextLabel")
    measure.Text=text
    measure.Size=UDim2.new(0,200,0,0)
    measure.AutomaticSize=Enum.AutomaticSize.XY
    measure.BackgroundTransparency=1
    measure.TextColor3=Color3.new(1,1,1)
    measure.TextSize=11
    measure.Font=Enum.Font.Gotham
    measure.TextWrapped=true
    measure.MaxVisibleGraphemes=0 -- hidden, just for size
    measure.Parent=SG

    task.wait() -- let size compute
    local textH = math.max(36, measure.TextBounds.Y + 24)
    local textW = math.min(measure.TextBounds.X + 24, 210)
    measure:Destroy()

    -- bubble
    local bubble=Instance.new("Frame")
    bubble.Size=UDim2.new(0,textW,0,textH)
    bubble.AutomaticSize=Enum.AutomaticSize.Y
    bubble.BackgroundColor3=isUser and T.userBubble or T.aiBubble
    bubble.BackgroundTransparency=0.15
    bubble.BorderSizePixel=0
    bubble.ZIndex=5
    bubble.Parent=wrapper
    Instance.new("UICorner",bubble).CornerRadius=UDim.new(0,12)

    -- position right for user, left for AI
    if isUser then
        bubble.Position=UDim2.new(1,-textW-4,0,0)
        bubble.AnchorPoint=Vector2.new(0,0)
    else
        bubble.Position=UDim2.new(0,4,0,0)
    end

    -- bubble gradient
    local bGrad=Instance.new("UIGradient"); bGrad.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,isUser and Color3.fromRGB(32,32,44) or Color3.fromRGB(22,22,30)),
        ColorSequenceKeypoint.new(1,isUser and Color3.fromRGB(18,18,26) or Color3.fromRGB(12,12,16)),
    }); bGrad.Rotation=135; bGrad.Parent=bubble

    -- bubble stroke
    local bStroke=Instance.new("UIStroke"); bStroke.Color=Color3.new(1,1,1)
    bStroke.Thickness=0.7; bStroke.Transparency=isUser and 0.75 or 0.85; bStroke.Parent=bubble

    -- top shimmer on AI bubbles
    if not isUser then
        local shim=Instance.new("Frame"); shim.Size=UDim2.new(0.6,0,0,1)
        shim.Position=UDim2.new(0.2,0,0,0); shim.BackgroundColor3=Color3.new(1,1,1)
        shim.BackgroundTransparency=0.65; shim.BorderSizePixel=0; shim.ZIndex=6; shim.Parent=bubble
        Instance.new("UICorner",shim).CornerRadius=UDim.new(1,0)
    end

    -- sender label
    local senderLbl=Instance.new("TextLabel")
    senderLbl.Text=isUser and "You" or "DPM-AI"
    senderLbl.Size=UDim2.new(1,-10,0,12)
    senderLbl.Position=UDim2.new(0,8,0,5)
    senderLbl.BackgroundTransparency=1
    senderLbl.TextColor3=isUser and T.dim or Color3.fromRGB(140,140,160)
    senderLbl.TextSize=8; senderLbl.Font=Enum.Font.GothamBold
    senderLbl.TextXAlignment=Enum.TextXAlignment.Left
    senderLbl.ZIndex=6; senderLbl.Parent=bubble

    -- message label
    local msgLbl=Instance.new("TextLabel")
    msgLbl.Text=""
    msgLbl.Size=UDim2.new(1,-16,0,0)
    msgLbl.Position=UDim2.new(0,8,0,18)
    msgLbl.AutomaticSize=Enum.AutomaticSize.Y
    msgLbl.BackgroundTransparency=1
    msgLbl.TextColor3=isUser and T.offWhite or Color3.new(1,1,1)
    msgLbl.TextSize=11; msgLbl.Font=Enum.Font.Gotham
    msgLbl.TextWrapped=true
    msgLbl.TextXAlignment=Enum.TextXAlignment.Left
    msgLbl.ZIndex=6; msgLbl.Parent=bubble

    -- entrance animation
    bubble.BackgroundTransparency=1
    TweenService:Create(bubble,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{
        BackgroundTransparency=0.15
    }):Play()

    -- typewriter effect for AI
    if not isUser then
        task.spawn(function()
            for i=1,#text do
                msgLbl.Text=text:sub(1,i)
                task.wait(0.018)
            end
            scrollToBottom()
        end)
    else
        msgLbl.Text=text
        scrollToBottom()
    end

    wrapper.Size=UDim2.new(1,0,0,textH+8)
    return bubble
end

