local function getAIResponse(input)
    local lower = input:lower()
    -- find matching response
    for _, entry in pairs(responses) do
        for _, pat in pairs(entry.patterns) do
            if lower:find(pat) then
                local ans = entry.answers
                return ans[math.random(1, #ans)]
            end
        end
    end
    -- fallback
    return fallbacks[math.random(1, #fallbacks)]
end

