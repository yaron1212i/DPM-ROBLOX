local typingWrapper=nil
local typingBubble=nil
local typingConn=nil

local function showTyping()
    typingWrapper=Instance.new("Frame")
    typingWrapper.Name="Typing"
    typingWrapper.Size=UDim2.new(1,0,0,44)
    typingWrapper.BackgroundTransparency=1
    typingWrapper.BorderSizePixel=0
    typingWrapper.LayoutOrder=9999
    typingWrapper.ZIndex=4
    typingWrapper.Parent=ChatFrame

    typingBubble=Instance.new("Frame")
    typingBubble.Size=UDim2.new(0,70,0,34)
    typingBubble.Position=UDim2.new(0,4,0,0)
    typingBubble.BackgroundColor3=T.aiBubble
    typingBubble.BackgroundTransparency=0.15
    typingBubble.BorderSizePixel=0; typingBubble.ZIndex=5; typingBubble.Parent=typingWrapper
    Instance.new("UICorner",typingBubble).CornerRadius=UDim.new(0,12)

    local tGrad=Instance.new("UIGradient"); tGrad.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,Color3.fromRGB(22,22,30)),
        ColorSequenceKeypoint.new(1,Color3.fromRGB(12,12,16)),
    }); tGrad.Rotation=135; tGrad.Parent=typingBubble

    -- three dots
    local dotHolder=Instance.new("Frame"); dotHolder.Size=UDim2.new(1,0,1,0)
    dotHolder.BackgroundTransparency=1; dotHolder.ZIndex=6; dotHolder.Parent=typingBubble
    local dLayout=Instance.new("UIListLayout"); dLayout.FillDirection=Enum.FillDirection.Horizontal
    dLayout.HorizontalAlignment=Enum.HorizontalAlignment.Center
    dLayout.VerticalAlignment=Enum.VerticalAlignment.Center
    dLayout.Padding=UDim.new(0,5); dLayout.Parent=dotHolder

    local dots={}
    for i=1,3 do
        local d=Instance.new("Frame"); d.Size=UDim2.new(0,7,0,7)
        d.BackgroundColor3=T.dim; d.BackgroundTransparency=0.2
        d.BorderSizePixel=0; d.ZIndex=7; d.Parent=dotHolder
        Instance.new("UICorner",d).CornerRadius=UDim.new(1,0)
        dots[i]=d
    end

    -- animate dots
    typingConn=RunService.Heartbeat:Connect(function()
        local t=tick()
        for i,d in pairs(dots) do
            local offset=(i-1)*0.25
            local v=0.5+math.sin((t+offset)*4)*0.5
            d.BackgroundColor3=Color3.fromRGB(
                math.floor(255*v),math.floor(255*v),math.floor(255*v))
            d.BackgroundTransparency=0.15+math.abs(math.sin((t+offset)*4))*0.5
        end
    end)

    TweenService:Create(typingBubble,TweenInfo.new(0.2),{BackgroundTransparency=0.15}):Play()
    scrollToBottom()
end

local function hideTyping()
    if typingConn then typingConn:Disconnect(); typingConn=nil end
    if typingWrapper then typingWrapper:Destroy(); typingWrapper=nil end
    typingBubble=nil
end

