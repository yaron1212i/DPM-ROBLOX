local function unload()
    if not alive then return end
    alive=false
    flags.Fly=false; flags.Spin=false
    stopFlight(); clearHighlights(); restoreAll()
    for _,label in pairs(labels) do label:Destroy() end
    tintEffect:Destroy(); bloomEffect:Destroy()
    for _,t in pairs(activeTweens) do t:Cancel() end
    for _,c in ipairs(connections) do c:Disconnect() end
    gui:Destroy()
end
