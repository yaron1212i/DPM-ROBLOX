refreshRows=function()
    for _,r in ipairs(rows) do
        if r.state then
            local enabled=r.state()
            r.button.Text=r.name..(enabled and '  [ON]' or '  [OFF]')
            animate(r.button,{BackgroundColor3=enabled and accent or Color3.fromRGB(37,38,53)})
        end
