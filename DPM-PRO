local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(connections, c)
    return c
end
local function make(kind, props, parent)
    local x = Instance.new(kind)
    for k,v in pairs(props) do x[k] = v end
    x.Parent = parent
    return x
end
local function animate(obj, properties, duration)
    if activeTweens[obj] then activeTweens[obj]:Cancel() end
    local t=Tween:Create(obj,TweenInfo.new(duration or animationTime,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),properties)
    activeTweens[obj]=t
    t:Play()
end
local function corner(x) make('UICorner', {CornerRadius=UDim.new(0,9)}, x) end
local function write(obj, key, value)
    if not obj then error('Object is not available yet') end
    if not changes[obj] then changes[obj] = {} end
    if changes[obj][key] == nil then changes[obj][key] = {obj[key]} end
    obj[key] = value
end
local function restoreKey(obj, key)
    local saved = changes[obj]
    if saved and saved[key] then
        pcall(function() obj[key] = saved[key][1] end)
        saved[key] = nil
        if next(saved) == nil then changes[obj] = nil end
    end
end
local function restoreAll()
    for obj, props in pairs(changes) do
        for key, value in pairs(props) do
            pcall(function() obj[key] = value[1] end)
        end
    end
    changes = {}
end
