local function action(group,name,fn,state)
    local b = button(name,list,UDim2.new(1,-6,0,35))
    b.LayoutOrder = #rows+1
    local row = {button=b,group=group,name=name,state=state}
    table.insert(rows,row)
    connect(b.Activated,function()
        local ok,err = pcall(fn)
        if not alive then return end
        status.Text = ok and ('Applied: '..name) or ('Unavailable: '..tostring(err))
        refreshRows()
        if state then b.Text=name..(state() and '  [ON]' or '  [OFF]') end
    end)
    if state then b.Text=name..(state() and '  [ON]' or '  [OFF]') end
end
-- One shared drag listener, including touch identity and focus-loss cleanup.
local sliderDrag
local function quantize(value,low,high,step)
    value=math.clamp(value,low,high)
    return math.clamp(low+math.floor((value-low)/step+.5)*step,low,high)
end
local function slider(group,id,name,low,high,step,initial,apply)
    settings[id]=initial
    local box=make('Frame',{Size=UDim2.new(1,-6,0,80),BackgroundColor3=Color3.fromRGB(29,30,43),
        BorderSizePixel=0,LayoutOrder=#rows+1},list)
    corner(box)
    make('TextLabel',{Text=name,Position=UDim2.fromOffset(12,6),Size=UDim2.new(1,-150,0,27),
        BackgroundTransparency=1,TextColor3=Color3.fromRGB(235,235,249),Font=Enum.Font.Gotham,
        TextSize=13,TextXAlignment=Enum.TextXAlignment.Left},box)
    local valueBox=make('TextBox',{Text='',Position=UDim2.new(1,-117,0,7),Size=UDim2.fromOffset(68,26),
        BackgroundColor3=Color3.fromRGB(42,44,62),TextColor3=Color3.new(1,1,1),BorderSizePixel=0,
        Font=Enum.Font.GothamBold,TextSize=13,ClearTextOnFocus=false},box)
    corner(valueBox)
    local reset=button('R',box,UDim2.fromOffset(28,26),UDim2.new(1,-39,0,7))
    local hit=make('TextButton',{Name='SliderTrack',Text='',Size=UDim2.new(1,-32,0,36),
        Position=UDim2.fromOffset(16,35),BackgroundTransparency=1,AutoButtonColor=false},box)
    local track=make('Frame',{Size=UDim2.new(1,0,0,6),Position=UDim2.new(0,0,.5,-3),
        BackgroundColor3=Color3.fromRGB(53,55,76),BorderSizePixel=0},hit)
    corner(track)
    local fill=make('Frame',{Size=UDim2.new(0,0,1,0),BackgroundColor3=accent,BorderSizePixel=0},track)
    corner(fill)
    local knob=make('Frame',{Size=UDim2.fromOffset(16,16),AnchorPoint=Vector2.new(.5,.5),
        Position=UDim2.new(0,0,.5,0),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0},track)
    corner(knob)
    local control={initial=initial,id=id,name=name,apply=apply,fill=fill,low=low,high=high,step=step}
    local function render()
        local a=math.clamp((settings[id]-low)/(high-low),0,1)
        valueBox.Text=string.format('%.2f',settings[id]):gsub('0+$',''):gsub('%.$','')
        animate(fill,{Size=UDim2.new(a,0,1,0)},.07)
        animate(knob,{Position=UDim2.new(a,0,.5,0)},.07)
    end
    function control.set(value,commit,exact)
        if type(value)~='number' or value~=value or math.abs(value)==math.huge then return false end
        if not exact then value=quantize(value,low,high,step) end
        if commit then
            local ok,err=pcall(apply,value)
            if not ok then status.Text='Unavailable: '..tostring(err); render(); return false end
            liveSettings[id]=true
        end
        settings[id]=value
        render()
        if commit then status.Text=name..': '..valueBox.Text end
        return true
    end
    control.render=render
    controls[id]=control
    table.insert(rows,{button=box,group=group,name=name,control=true})
    local function atX(x)
        local width=math.max(1,hit.AbsoluteSize.X)
        control.set(low+(high-low)*math.clamp((x-hit.AbsolutePosition.X)/width,0,1),true)
    end
    connect(hit.InputBegan,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            sliderDrag={input=input,move=atX}; list.ScrollingEnabled=false
            atX(input.Position.X)
        end
    end)
    connect(valueBox.FocusLost,function()
        if not control.set(tonumber(valueBox.Text),true) then render() end
    end)
    connect(reset.Activated,function() control.set(initial,true,true) end)
    render()
end
connect(UIS.InputChanged,function(input)
    if sliderDrag and (input==sliderDrag.input or
        (sliderDrag.input.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement)) then
        sliderDrag.move(input.Position.X)
    end
end)
local function endSlider() sliderDrag=nil; list.ScrollingEnabled=true end
connect(UIS.InputEnded,function(input) if sliderDrag and input==sliderDrag.input then endSlider() end end)
connect(UIS.WindowFocusReleased,endSlider)
