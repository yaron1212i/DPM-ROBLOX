local function make(kind, props, parent)
    local x = Instance.new(kind)
    for k,v in pairs(props) do x[k] = v end
    x.Parent = parent
    return x
end
local function animate(obj, properties, duration)
    if activeTweens[obj] then activeTweens[obj]:Cancel() end
    local t=Tween:Create(obj,TweenInfo.new(duration or animationTime,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),properties)
    activeTweens[obj]=t
    t:Play()
end
-- Translucent surfaces use independently readable text and white edge highlights.
local glassSurfaces={}
local function glassAlpha(entry,value)
    return math.clamp(value+entry.offset-(entry.hovered and .12 or 0),.08,.9)
end
local function applyGlass(value)
    for obj,entry in pairs(glassSurfaces) do
        if obj.Parent then
            animate(obj,{BackgroundTransparency=glassAlpha(entry,value)},.15)
        end
    end
end
local function glass(obj,offset,border)
    local entry={offset=offset or 0,hovered=false}
    glassSurfaces[obj]=entry
    obj.BackgroundTransparency=glassAlpha(entry,settings.glass)
    if border then
        make('UIStroke',{Color=Color3.fromRGB(218,234,255),Thickness=1,
            Transparency=.8,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},obj)
    end
end
local function glassHover(obj,hovered)
    local entry=glassSurfaces[obj]
    if entry then
        entry.hovered=hovered
        animate(obj,{BackgroundTransparency=glassAlpha(entry,settings.glass)},.16)
    end
end
local function corner(x) make('UICorner', {CornerRadius=UDim.new(0,9)}, x) end
local function write(obj, key, value)
    if not obj then error('Object is not available yet') end
    if not changes[obj] then changes[obj] = {} end
    if changes[obj][key] == nil then changes[obj][key] = {obj[key]} end
    obj[key] = value
end
local function restoreKey(obj, key)
    local saved = changes[obj]
    if saved and saved[key] then
        pcall(function() obj[key] = saved[key][1] end)
        saved[key] = nil
        if next(saved) == nil then changes[obj] = nil end
    end
end
local function restoreAll()
    for obj, props in pairs(changes) do
        for key, value in pairs(props) do
            pcall(function() obj[key] = value[1] end)
        end
    end
    changes = {}
end
