local function fit()
    local camera=workspace.CurrentCamera
    if not camera then return end
    local v=camera.ViewportSize
    baseScale=math.max(.2,math.min(1,(v.X-24)/560,(v.Y-70)/500))
    scale.Scale=baseScale*openAmount
    panel.Position=UDim2.fromOffset(math.max(0,(v.X-560*scale.Scale)/2),math.max(0,(v.Y-500*scale.Scale)/2-20))
end
local cameraConnection
local function bindCamera()
    if cameraConnection then cameraConnection:Disconnect() end
    local camera=workspace.CurrentCamera
    if camera then cameraConnection=connect(camera:GetPropertyChangedSignal('ViewportSize'),fit) end
    fit()
    if liveSettings.fov and camera then controls.fov.set(settings.fov,true) end
end
connect(workspace:GetPropertyChangedSignal('CurrentCamera'),bindCamera)
