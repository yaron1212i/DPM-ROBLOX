    {'Bloom','Bloom lighting'},{'ColorGrade','Color grading'},
    {'Rainbow','Animated rainbow accent'},{'HUD','Live speed / FPS HUD'},
    {'Trail','Rainbow movement trail (local)'},{'Headlamp','Character headlamp (local)'},
    {'DayCycle','Animated day / night cycle'},{'NoFog','Remove fog and atmosphere'},
    {'HideSelf','Hide own avatar (local)'},{'Crosshair','Center crosshair'},
    {'Blur','Cinematic screen blur'},{'SunRays','Sun rays effect'},
    {'AliveOnly','Hide dead players in overlays'},{'LauncherPulse','Pulsing launcher glow'}}) do
    local key,label = entry[1],entry[2]
    action('Tools',label,function()
        flags[key]=not flags[key]
        local _,h=body()
        if key=='Trail' and not flags.Trail then clearTrail() end
        if key=='Headlamp' and not flags.Headlamp then clearLamp() end
        if key=='DayCycle' and not flags.DayCycle then
            if liveSettings.clock then write(Light,'ClockTime',settings.clock) else restoreKey(Light,'ClockTime') end
        end
        if key=='NoFog' then
            if flags.NoFog then applyFogRemoval() else
                restoreKey(Light,'FogStart'); restoreKey(Light,'FogEnd')
                restorePropertyEverywhere('Density'); restorePropertyEverywhere('Haze')
            end
        end
        if key=='HideSelf' and not flags.HideSelf then restorePropertyEverywhere('LocalTransparencyModifier') end
        if key=='Crosshair' then crosshair.Visible=flags.Crosshair end
        if key=='Blur' then blurEffect.Enabled=flags.Blur end
        if key=='SunRays' then sunEffect.Enabled=flags.SunRays end
        if key=='Spin' and not flags.Spin and not flags.Fly and h then restoreKey(h,'AutoRotate') end
        if key=='Sprint' and not flags.Sprint and h then
            if liveSettings.walk then write(h,'WalkSpeed',settings.walk) else restoreKey(h,'WalkSpeed') end
        end
        if key=='Fullbright' then
            if flags.Fullbright then
                write(Light,'Ambient',Color3.new(1,1,1)); write(Light,'OutdoorAmbient',Color3.new(1,1,1))
            else restoreKey(Light,'Ambient'); restoreKey(Light,'OutdoorAmbient') end
        end
        if key=='NoShadows' then
            if flags.NoShadows then write(Light,'GlobalShadows',false) else restoreKey(Light,'GlobalShadows') end
        end
        if key=='Bloom' then bloomEffect.Enabled=flags.Bloom end
        if key=='ColorGrade' then tintEffect.Enabled=flags.ColorGrade end
        if key=='Nameplates' and not flags.Nameplates then
            for _,label in pairs(labels) do label:Destroy() end; labels={}
        end
        if key=='Fly' and not flags.Fly then stopFlight() end
        if key=='Noclip' and not flags.Noclip then restoreCollisions() end
        if key=='Outlines' and not flags.Outlines then clearHighlights() end
    end,function() return flags[key] end)
end
