local function clearHighlights()
    for _,h in pairs(highlights) do h:Destroy() end
    highlights = {}
end
local function restoreCollisions()
    local targets = {}
    for obj,props in pairs(changes) do
        if props.CanCollide then table.insert(targets,obj) end
    end
    for _,obj in ipairs(targets) do restoreKey(obj,'CanCollide') end
end
local function stopFlight()
    if flightForce then flightForce:Destroy(); flightForce=nil end
    if flightAttachment then flightAttachment:Destroy(); flightAttachment=nil end
    local _,h,r = body()
    if h then restoreKey(h,'PlatformStand'); if not flags.Spin then restoreKey(h,'AutoRotate') end end
    if r then r.AssemblyLinearVelocity=Vector3.new() end
end
local function clearTrail()
    for _,x in ipairs({trail or false,trailLeft or false,trailRight or false}) do if x then x:Destroy() end end
    trail=nil; trailLeft=nil; trailRight=nil
end
local function clearLamp() if headlamp then headlamp:Destroy(); headlamp=nil end end
local function restorePropertyEverywhere(key)
    local objects={}
    for obj,props in pairs(changes) do if props[key] then objects[#objects+1]=obj end end
    for _,obj in ipairs(objects) do restoreKey(obj,key) end
end
