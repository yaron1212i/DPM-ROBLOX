            (UIS:IsKeyDown(Enum.KeyCode.LeftShift) and not UIS:GetFocusedTextBox())
        local saved=changes[h] and changes[h].WalkSpeed
        local base=liveSettings.walk and settings.walk or (saved and saved[1] or h.WalkSpeed)
        write(h,'WalkSpeed',sprinting and settings.sprint or base)
    end
    if flags.Bunnyhop and not flags.Fly and not h.Sit and h.MoveDirection.Magnitude>.05
        and h.FloorMaterial~=Enum.Material.Air then h.Jump=true end
    if flags.Spin then
        write(h,'AutoRotate',false)
        r.CFrame=r.CFrame*CFrame.Angles(0,math.rad(settings.spin)*dt,0)
    end
    if flags.Fly then
        if not flightAttachment or flightAttachment.Parent~=r then
            if flightForce then flightForce:Destroy() end
            if flightAttachment then flightAttachment:Destroy() end
            flightAttachment=make('Attachment',{Name='DPM_FlightAttachment'},r)
            flightForce=make('VectorForce',{Name='DPM_GravityCompensation',Attachment0=flightAttachment,
                RelativeTo=Enum.ActuatorRelativeTo.World,ApplyAtCenterOfMass=true},r)
        end
        flightForce.Force=Vector3.new(0,r.AssemblyMass*workspace.Gravity,0)
        write(h,'PlatformStand',true); write(h,'AutoRotate',false)
